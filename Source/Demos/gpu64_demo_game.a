lnIx		.byte 0
lnI		.byte 0
lnK		.byte 0
lnFlag		.fill 256, 0


; ----------------------------------------------------------------------
; sin(a) as 8.8, 256 entries over a full turn: the whole reason the camera
; can live on the C64. The index is the TOP byte of the 16-bit wire angle,
; which makes the truncation from 65536 steps to 256 a shift and the wrap
; free.
;
; The range is -256..+256 inclusive, so it does not fit in a byte and the
; table is two. That is also why camAdd multiplies magnitudes and carries
; the sign separately: a signed 8-bit multiply has nowhere to put sin(64).
;
; 64tass evaluates sin() and round() at assembly time, so this costs 512
; bytes of PRG and no code.
; ----------------------------------------------------------------------
sinLo
	.for i = 0, i < 256, i += 1
	.byte <(round(sin(i * 2 * pi / 256) * 256))
	.next
sinHi
	.for i = 0, i < 256, i += 1
	.byte >(round(sin(i * 2 * pi / 256) * 256))
	.next

	.include "gpu64_demo_rt.inc"
